# Required. You sign in to the web app with this (openssl rand -base64 24).
GATEWAY_PASSWORD=
# Required. Seals stored app passwords and sign-in tokens (openssl rand -base64 32). Keep it out of backups of /data.
GATEWAY_KEY=
# Only for plain http on this machine (no https in front): uncomment so the browser keeps the session cookie.
# GATEWAY_INSECURE_COOKIES=1
